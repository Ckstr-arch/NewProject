// Editable source. From nsbm-sportshub-frontend/ run:
// dot -Tsvg docs/diagrams/architecture.dot -o docs/diagrams/architecture.svg
digraph SportsHub {
  graph [rankdir=TB, compound=true, newrank=true, bgcolor="#f5f7fb", pad="0.35", nodesep="0.65", ranksep="0.5", fontname="DejaVu Sans", fontsize=23, fontcolor="#081b33", label="NSBM SPORTSHUB\nSystem architecture", labelloc=t, labeljust=l, splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#dbe3ed", fontname="DejaVu Sans", fontsize=12, fontcolor="#132238", margin="0.2,0.17", penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=10, color="#6a7c93", fontcolor="#52647c", arrowsize=0.7];

  people [label="STUDENT / ADMIN\nOne application with role-aware controls", fillcolor="#081b33", fontcolor="#ffffff", color="#081b33"];

  subgraph cluster_frontend {
    label="IMPLEMENTED · BROWSER FRONTEND"; fontsize=14; fontcolor="#0d2a4b"; color="#cbd8e7"; style="rounded,filled"; fillcolor="#edf2f8"; margin=22;
    entry [label="ENTRY & INITIALIZATION\nindex.html + css/styles.css + js/app.js\nApply theme → api.session() → store user → start router\nNative ES modules; served over HTTP"];
    ui [label="ROUTING & USER INTERFACE\nrouter.js: hash routes, login guard, admin-only Reports\nviews/: Login · Dashboard · Clubs · Memberships\nSchedules · Tournaments · Results · Bookings · Reports · Settings\ncomponents/: navbar, dialogs, tables/forms, toasts\nutils/: escaping, formatting, validation"];
    state [label="SHARED STATE · store.js\nUser · route · theme · notifications · loading\nIn-memory state + subscriptions\nTheme saved separately as sportshub-theme\nPage-local form/filter state stays in views", fillcolor="#e8f2ff"];
    api [label="CENTRALIZED API · services/api.js\n43 named methods from services/endpoints.js\nID validation + one selected request(method, path, body, query) adapter\nconfig.js: API_MODE · API_BASE_URL · REQUEST_TIMEOUT\nSame response envelopes; no live-to-mock fallback", fillcolor="#b8f34a", color="#9bdc25"];
    mock [label="MOCK ADAPTER · mock-api.js\nDemo latency + role/validation checks\nCRUD · approvals · registration · booking conflicts\nMetrics · standings · reports\nDemo reset is a local-only extra operation", fillcolor="#eff8dc", color="#aecf75"];
    http [label="LIVE ADAPTER · http.js\nFetch + credentials: include + JSON\nIn-memory CSRF token; header on every write\nTimeout/abort · normalized errors · empty 204\n401 signals session expiry to app.js", fillcolor="#e8f2ff", color="#97b6df"];
    demo [shape=cylinder, label="DEMO localStorage\nCONFIG.MOCK_STORAGE_KEY\nRecords + simulated sessionUserId\nNo passwords or real session tokens", fillcolor="#eff8dc", color="#aecf75"];
    entry -> ui [label="guarded rendering after session bootstrap"];
    ui -> state [dir=both, style=dotted, label="read / update / subscribe", constraint=false];
    {rank=same;ui;state;}
    ui -> api [label="data reads / mutations; navbar logout"];
    api -> mock [label="API_MODE = mock"];
    api -> http [label="API_MODE = live"];
    {rank=same;mock;http;}
    mock -> demo [label="read / persist demo data"];
  }

  subgraph cluster_backend {
    label="IMPLEMENTED PHP / MySQL BACKEND · SERVER TRUST BOUNDARY\nSibling backend/ directory · API_CONTRACT.md";
    fontsize=13; fontcolor="#52647c"; color="#8294aa"; penwidth=1.5; style="rounded,dashed,filled"; fillcolor="#f1f4f8"; margin=20;
    php [label="PHP API · CONFIG.API_BASE_URL\nServer-managed sessions + CSRF verification\nRole/ownership enforcement + authoritative validation\nBusiness rules + transactions + prepared PDO queries\nSecure, HttpOnly session cookie in production", style="rounded,dashed,filled", fillcolor="#ffffff", color="#8294aa"];
    mysql [shape=cylinder, label="MySQL · persistent data\nUsers · clubs · memberships · schedules\nTournaments · registrations · matches\nFacilities/equipment · bookings · participation", style="dashed,filled", color="#8294aa"];
    php -> mysql [label="validated queries / transactional writes"];
  }
  people -> entry [label="opens the app over HTTP"];
  http -> php [label="HTTP(S) JSON + session cookies\nX-CSRF-Token on writes", style=dashed, penwidth=1.5, lhead=cluster_backend];
  {rank=same;demo;php;}
  legend [shape=plain, label="SOLID: request/render/persistence flow   ·   DOTTED: shared-state dependency\nDASHED: server-side trust and network boundary\nResponses return through the selected adapter. The UI refreshes only after successful writes.\nThe live adapter's session cookie is browser-managed; live authentication is never stored in localStorage.", fontsize=11, fontcolor="#52647c"];
  demo -> legend [style=invis];
  mysql -> legend [style=invis];
}
